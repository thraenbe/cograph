{
  "name": "cograph",
  "displayName": "CoGraph",
  "description": "Interactive call graph visualization for Python, TypeScript, JavaScript, Java, and C++ projects",
  "version": "1.2.0",
  "publisher": "thraenbe",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/thraenbe/cograph.git"
  },
  "bugs": {
    "url": "https://github.com/thraenbe/cograph/issues"
  },
  "homepage": "https://github.com/thraenbe/cograph#readme",
  "license": "MIT",
  "keywords": [
    "python",
    "typescript",
    "javascript",
    "java",
    "cpp",
    "c++",
    "call graph",
    "visualization",
    "dependency",
    "graph"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages"
  ],
  "activationEvents": [
    "onCommand:cograph.visualize",
    "onCommand:cograph.openOrReload",
    "onCommand:cograph.saveGraph",
    "onCommand:cograph.saveGraphAs",
    "onView:cograph.savedGraphs"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cograph-sidebar",
          "title": "Cograph",
          "icon": "./media/cograph-sidebar.svg"
        }
      ]
    },
    "views": {
      "cograph-sidebar": [
        {
          "type": "webview",
          "id": "cograph.savedGraphs",
          "name": "Cograph"
        }
      ]
    },
    "commands": [
      {
        "command": "cograph.visualize",
        "title": "CoGraph: Visualize Project"
      },
      {
        "command": "cograph.openOrReload",
        "title": "CoGraph: Open or Reload Layout",
        "icon": {
          "light": "./media/icon-light.svg",
          "dark": "./media/icon-dark.svg"
        }
      },
      {
        "command": "cograph.saveGraph",
        "title": "CoGraph: Save Graph"
      },
      {
        "command": "cograph.saveGraphAs",
        "title": "CoGraph: Save Graph As…"
      }
    ],
    "keybindings": [
      {
        "command": "cograph.saveGraph",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeWebviewPanelId == 'cograph'"
      },
      {
        "command": "cograph.saveGraphAs",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s",
        "when": "activeWebviewPanelId == 'cograph'"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "cograph.openOrReload",
          "group": "navigation",
          "when": "true"
        }
      ]
    },
    "configuration": {
      "title": "CoGraph",
      "properties": {
        "cograph.graphIntelligence.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "Enable AI-powered features (Chat and the AI Workflow Graph). When off, these features are disabled until you turn them on here. AI features run the Claude Code / Codex CLI on your behalf."
        },
        "cograph.graphIntelligence.provider": {
          "type": "string",
          "enum": [
            "claude-code",
            "codex"
          ],
          "enumDescriptions": [
            "Claude Code CLI (Anthropic)",
            "OpenAI Codex CLI"
          ],
          "default": "claude-code",
          "description": "Provider used for Graph Intelligence requests."
        },
        "cograph.graphIntelligence.model": {
          "type": "string",
          "enum": [
            "default",
            "opus",
            "sonnet",
            "haiku",
            "opusplan"
          ],
          "enumDescriptions": [
            "Your Claude Code account default",
            "Opus — deepest reasoning (slow, most expensive)",
            "Sonnet — balanced speed and quality (recommended)",
            "Haiku — fastest, cheapest, no extended thinking",
            "Opus Plan — Opus for planning, Sonnet for execution"
          ],
          "default": "sonnet",
          "description": "Claude model used for Graph Intelligence requests (when provider is claude-code)."
        },
        "cograph.graphIntelligence.codex.model": {
          "type": "string",
          "enum": [
            "gpt-5-codex",
            "gpt-5",
            "gpt-5-mini"
          ],
          "enumDescriptions": [
            "GPT-5 fine-tuned for code (recommended)",
            "GPT-5 general purpose",
            "Smaller, cheaper, faster"
          ],
          "default": "gpt-5-codex",
          "description": "Codex model used for Graph Intelligence requests (when provider is codex)."
        },
        "cograph.graphIntelligence.effort": {
          "type": "string",
          "enum": [
            "auto",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "auto",
          "description": "Reasoning effort for Opus/Opus Plan. 'auto' lets the CLI choose; ignored for Sonnet/Haiku."
        },
        "cograph.graphIntelligence.maxTurns": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "maximum": 50,
          "description": "Hard cap on tool-use iterations per request."
        },
        "cograph.graphIntelligence.maxBudgetUsd": {
          "type": "number",
          "default": 2,
          "minimum": 0.1,
          "description": "Hard spend cap (USD) per request. Claude aborts if exceeded."
        },
        "cograph.graphIntelligence.timeoutMs": {
          "type": "number",
          "default": 300000,
          "description": "Max milliseconds to wait for a Graph Intelligence response."
        },
        "cograph.largeRepo.autoEngage": {
          "type": "boolean",
          "default": true,
          "description": "Open in progressive folder-cluster mode — a single project node that expands one level per click — instead of laying out the whole graph at once. Applies to all repos; disable to fall back to the flat graph."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "bundle": "node esbuild.js",
    "bundle:watch": "node esbuild.js --watch",
    "pretest": "npm run compile && npm run bundle",
    "test": "node ./out/test/runTest.js",
    "lint": "eslint src --ext ts",
    "build:cpp-grammar": "tree-sitter build --wasm node_modules/tree-sitter-cpp -o scripts/tree-sitter-cpp.wasm",
    "package": "node --require ./scripts/node18-polyfill.js ./node_modules/@vscode/vsce/vsce package",
    "publish": "node --require ./scripts/node18-polyfill.js ./node_modules/@vscode/vsce/vsce publish"
  },
  "dependencies": {
    "java-parser": "^3.0.1",
    "typescript": "^6.0.3",
    "web-tree-sitter": "0.26.9"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.0.0",
    "@types/sinon": "^17.0.0",
    "@types/vscode": "^1.64.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/test-electron": "^2.3.0",
    "@vscode/vsce": "^2.32.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.0.0",
    "glob": "^13.0.6",
    "jsdom": "^25.0.1",
    "mocha": "^10.4.0",
    "sinon": "^17.0.0",
    "tree-sitter-cli": "0.26.9",
    "tree-sitter-cpp": "^0.22.3"
  }
}
